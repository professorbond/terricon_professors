# Скопируйте в .env (он в .gitignore). Значения по умолчанию подходят для локального демо.

# --- backend ---
# DATABASE_URL=postgresql+asyncpg://janamen:janamen@localhost:5432/janamen
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
DEMO_MODE=true
# Включённые ext-фичи Даниила: "*" — все, "" — ни одной, или список через запятую
EXT_FEATURES=*
# Без ключа AI Jana работает в экстрактивном режиме (ответ фрагментом базы знаний)
ANTHROPIC_API_KEY=
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- frontend (публичные переменные Vite — секреты сюда НЕ класть) ---
VITE_API_URL=http://localhost:8000
